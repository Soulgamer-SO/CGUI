{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "gdb",
            "request": "launch",
            "name": "Debug(gdb)",
            "target": "${workspaceFolder}/build/debug/cgui-app",
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText"
        },
        {
            "type": "gdb",
            "request": "launch",
            "name": "Test(gdb)",
            "target": "${workspaceFolder}/build/test/cgui-app-test",
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText"
        }
    ]
}